<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Notatki"
             x:Class="Notatki.MainPage" BackgroundColor="#F0F8FF">
    <StackLayout Spacing="5" BackgroundColor="#F0F8FF">
        <Label Text="Notatki" FontSize="26" TextColor="#0000CD" />
        <ListView x:Name="ListaNotatek" VerticalOptions="FillAndExpand" HasUnevenRows="True" BackgroundColor="#F0F8FF" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Notatka">
                    <ViewCell>
                        <VerticalStackLayout Padding="8,4">
                            <Label Text="{Binding Tytul}" TextColor="Black" />
                            <Label Text="{Binding Tresc}" TextColor="Gray" FontSize="12" />
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Label Text="Dodanie notatki" FontSize="22" TextColor="#0000CD" />
        <Label Text="Tytuł notatki: " TextColor="Black" />
        <Entry x:Name="TytulNotatki" TextColor="Black" />
        <Label Text="Treść notatki: " TextColor="Black" />
        <Entry x:Name="TrescNotatki" TextColor="Black" />
        <Button Text="DODAJ" TextColor="#0000CD" BackgroundColor="LightGray" Clicked="Dodaj" />
    </StackLayout>
</ContentPage>
